rules_version = '2';

// Mochi Island: exactly two members, listed in config/members (console-only).
// Everything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember() {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/config/members).data.uids;
    }

    function isSelf(uid) {
      return isMember() && request.auth.uid == uid;
    }

    function sulkEnabled() {
      return get(/databases/$(database)/documents/config/features).data.sulk == true;
    }

    // Myanmar day number (UTC+6:30), decided by the server clock.
    // Must match myanmarDayNumber in src/core/time.ts.
    // int(): math.floor returns a float, whose string() would be "20402.0",
    // not the "20402" document id the app uses.
    function myanmarDay() {
      return int(math.floor((request.time.toMillis() + 23400000) / 86400000));
    }

    function onlyKeys(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    match /config/{doc} {
      allow read: if isMember();
      allow write: if false;
    }

    match /profiles/{uid} {
      allow read: if isMember();
      allow create, update: if isSelf(uid)
        && onlyKeys(['displayName', 'phraseChosen'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.phraseChosen is bool;
      allow delete: if isSelf(uid);
    }

    function members() {
      return get(/databases/$(database)/documents/config/members).data.uids;
    }

    // The writer or the recipient of an existing star-like doc.
    function isPartyTo(data) {
      return isMember()
        && (data.fromUid == request.auth.uid || data.toUid == request.auth.uid);
    }

    // Stars: the writer sees what they wrote, never whether it was opened
    // (that lives in openedStars/{recipient}, which the writer cannot read).
    match /stars/{starId} {
      allow read: if isPartyTo(resource.data);
      allow create: if isMember()
        && onlyKeys(['fromUid', 'toUid', 'text', 'hasPhoto', 'createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.toUid in members()
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && request.resource.data.hasPhoto is bool
        && (request.resource.data.text.size() > 0 || request.resource.data.hasPhoto)
        && request.resource.data.createdAt == request.time
        // A star with a photo is only valid together with its photo (one batch).
        && (!request.resource.data.hasPhoto
          || existsAfter(/databases/$(database)/documents/starPhotos/$(starId)));
      allow update: if false;
      allow delete: if isPartyTo(resource.data);
    }

    // Photo bytes live apart from the star so listing stars stays cheap.
    match /starPhotos/{starId} {
      allow read: if isPartyTo(resource.data);
      allow create: if isMember()
        && onlyKeys(['fromUid', 'toUid', 'data'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.data is bytes
        && request.resource.data.data.size() <= 900000
        && getAfter(/databases/$(database)/documents/stars/$(starId)).data.fromUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/stars/$(starId)).data.toUid == request.resource.data.toUid
        && getAfter(/databases/$(database)/documents/stars/$(starId)).data.hasPhoto == true;
      allow update: if false;
      allow delete: if isPartyTo(resource.data);
    }

    // How I feel now: one doc per person, overwritten (never a history).
    // It fades 8 h after setAt, calculated by the app; setAt is server time.
    match /feelings/{uid} {
      allow read: if isMember();
      allow create, update: if isSelf(uid)
        && onlyKeys(['feeling', 'setAt'])
        && request.resource.data.feeling in ['sleepy', 'hungry', 'happy', 'tired', 'bored', 'missingHome']
        && request.resource.data.setAt == request.time;
      allow delete: if isSelf(uid);
    }

    // Activities are deliberate shares, one current choice per member.
    // The app fades them after eight hours without storing a last-seen signal.
    match /activities/{uid} {
      allow read: if isMember();
      allow create, update: if isSelf(uid)
        && onlyKeys(['activity', 'setAt'])
        && request.resource.data.activity in ['teaching', 'resting', 'playing', 'eating', 'meeting', 'coding', 'music', 'studying']
        && request.resource.data.setAt == request.time;
      allow delete: if isSelf(uid);
    }

    // One shared timestamp for the last intentional visit to a partner island.
    match /islandVisits/{uid} {
      allow read: if isMember();
      allow create, update: if isSelf(uid)
        && onlyKeys(['visitedAt', 'destination'])
        && (!('destination' in request.resource.data) || request.resource.data.destination in ['noe', 'khant', 'shared'])
        && request.resource.data.visitedAt == request.time;
      allow delete: if isSelf(uid);
    }

    // A treat is seen once by its recipient, who then deletes it.
    // The sender cannot read it back.
    match /treats/{treatId} {
      allow read: if isMember() && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow delete: if isMember() && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow create: if isMember()
        && onlyKeys(['fromUid', 'toUid', 'kind'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.toUid in members()
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.toUid))
        && request.resource.data.kind in ['snack', 'blanket', 'hug', 'sweet', 'sticker'];
      allow update: if false;
    }

    function isLetterParty(data) {
      return isMember() && (data.fromUid == request.auth.uid || data.toUid == request.auth.uid);
    }

    // Letter metadata can show that a bottle exists, but its text stays in a
    // separate document until the chosen day.
    match /islandLetters/{letterId} {
      allow read: if isLetterParty(resource.data);
      allow create: if isMember()
        && onlyKeys(['kind', 'fromUid', 'toUid', 'opensAt', 'createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid in members()
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.toUid))
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.kind in ['snail', 'bottle']
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.kind == 'snail' && request.resource.data.opensAt == null)
          || (request.resource.data.kind == 'bottle' && request.resource.data.opensAt is timestamp
            && request.resource.data.opensAt > request.time))
        && existsAfter(/databases/$(database)/documents/islandLetterBodies/$(letterId));
      allow update: if false;
      allow delete: if isLetterParty(resource.data);
    }

    match /islandLetterBodies/{letterId} {
      allow read: if isLetterParty(resource.data)
        && (resource.data.fromUid == request.auth.uid
          || resource.data.kind == 'snail'
          || resource.data.opensAt <= request.time);
      allow create: if isMember()
        && onlyKeys(['kind', 'fromUid', 'toUid', 'text', 'opensAt', 'createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid in members()
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.toUid))
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/islandLetters/$(letterId)).data.fromUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/islandLetters/$(letterId)).data.toUid == request.resource.data.toUid
        && getAfter(/databases/$(database)/documents/islandLetters/$(letterId)).data.kind == request.resource.data.kind
        && getAfter(/databases/$(database)/documents/islandLetters/$(letterId)).data.opensAt == request.resource.data.opensAt;
      allow update: if false;
      allow delete: if isLetterParty(resource.data);
    }

    match /gardenMemories/{memoryId} {
      allow read: if isMember();
      allow create: if isMember()
        && onlyKeys(['fromUid', 'text', 'createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isMember();
    }

    // Only today's light is visible; old lighting activity is overwritten.
    match /lanterns/today {
      allow read: if isMember();
      allow create: if isMember()
        && onlyKeys(['day', 'litBy', 'updatedAt'])
        && request.resource.data.day == myanmarDay()
        && request.resource.data.litBy is list
        && request.resource.data.litBy.size() == 1
        && request.auth.uid in request.resource.data.litBy
        && request.resource.data.updatedAt == request.time;
      allow update: if isMember()
        && onlyKeys(['day', 'litBy', 'updatedAt'])
        && request.resource.data.day == myanmarDay()
        && request.resource.data.litBy is list
        && request.resource.data.litBy.size() <= 2
        && request.auth.uid in request.resource.data.litBy
        && request.resource.data.updatedAt == request.time
        && ((resource.data.day == myanmarDay()
          && request.resource.data.litBy.hasAll(resource.data.litBy)
          && ((request.auth.uid in resource.data.litBy
            && request.resource.data.litBy.size() == resource.data.litBy.size())
            || (!(request.auth.uid in resource.data.litBy)
              && request.resource.data.litBy.size() == resource.data.litBy.size() + 1)))
          || (resource.data.day != myanmarDay()
            && request.resource.data.litBy.size() == 1));
      allow delete: if isMember();
    }

    function activeSulk(data) {
      return data.endedAt == null
        && data.startedAt + duration.value(24, 'h') > request.time;
    }

    function pointerCanStart(uid) {
      let pointer = /databases/$(database)/documents/sulkPointers/$(uid);
      return !exists(pointer)
        || get(pointer).data.activeSulkId == null
        || !exists(/databases/$(database)/documents/sulks/$(get(pointer).data.activeSulkId))
        || !activeSulk(get(/databases/$(database)/documents/sulks/$(get(pointer).data.activeSulkId)).data);
    }

    match /sulks/{sulkId} {
      allow read: if isMember();
      allow create: if isMember() && sulkEnabled()
        && onlyKeys(['sulkerUid', 'level', 'reason', 'startedAt', 'endedAt', 'comfortCount'])
        && request.resource.data.sulkerUid == request.auth.uid
        && request.resource.data.level in ['cloudy', 'rain', 'storm']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 200
        && request.resource.data.startedAt == request.time
        && request.resource.data.endedAt == null
        && request.resource.data.comfortCount == 0
        && pointerCanStart(request.auth.uid)
        && getAfter(/databases/$(database)/documents/sulkPointers/$(request.auth.uid)).data.activeSulkId == sulkId;
      allow update: if isMember() && sulkEnabled()
        && ((resource.data.sulkerUid == request.auth.uid
            && activeSulk(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endedAt'])
            && request.resource.data.endedAt == request.time)
          || (resource.data.sulkerUid != request.auth.uid
            && activeSulk(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comfortCount', 'lastComfortId'])
            && request.resource.data.comfortCount == resource.data.comfortCount + 1
            && request.resource.data.lastComfortId is string
            && getAfter(/databases/$(database)/documents/sulkComforts/$(request.resource.data.lastComfortId)).data.sulkId == sulkId));
      allow delete: if isMember();
    }

    match /sulkPointers/{uid} {
      allow read: if isMember();
      allow create, update: if isSelf(uid) && sulkEnabled()
        && onlyKeys(['activeSulkId', 'startedAt'])
        && request.resource.data.activeSulkId is string
        && request.resource.data.startedAt == request.time
        && getAfter(/databases/$(database)/documents/sulks/$(request.resource.data.activeSulkId)).data.sulkerUid == uid
        && getAfter(/databases/$(database)/documents/sulks/$(request.resource.data.activeSulkId)).data.startedAt == request.time;
      allow delete: if isSelf(uid);
    }

    match /sulkComforts/{comfortId} {
      allow read: if isMember();
      allow create: if isMember() && sulkEnabled()
        && onlyKeys(['comfortId', 'sulkId', 'fromUid', 'toUid', 'kind', 'text', 'createdAt'])
        && request.resource.data.comfortId == comfortId
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.kind in ['hug', 'note', 'drops']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 200
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/sulks/$(request.resource.data.sulkId)).data.sulkerUid == request.resource.data.toUid
        && request.resource.data.toUid != request.auth.uid
        && activeSulk(get(/databases/$(database)/documents/sulks/$(request.resource.data.sulkId)).data)
        && getAfter(/databases/$(database)/documents/sulks/$(request.resource.data.sulkId)).data.lastComfortId == comfortId;
      allow update: if false;
      allow delete: if isMember();
    }
    // Push token for this person's phone. Only they can see or change it;
    // the Worker reads it with its service account (which bypasses rules).
    match /devices/{uid} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && onlyKeys(['token'])
        && request.resource.data.token is string
        && request.resource.data.token.size() <= 4096;
    }

    // Opened state lives under the recipient only, so the writer can never
    // see whether, when, or how many of their stars were opened.
    // Opening = one batch writing items/{starId} + days/{today}. The days doc
    // is create-only and must be today's server-decided Myanmar day, so one
    // star per day holds even if the phone's clock is wrong.
    match /openedStars/{uid}/items/{starId} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && onlyKeys(['openedAt'])
        && request.resource.data.openedAt == request.time
        && get(/databases/$(database)/documents/stars/$(starId)).data.toUid == uid
        && getAfter(/databases/$(database)/documents/openedStars/$(uid)/days/$(string(myanmarDay()))).data.starId == starId;
      allow update: if false;
      allow delete: if isSelf(uid);
    }

    match /openedStars/{uid}/days/{day} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && day == string(myanmarDay())
        && day.matches('^[0-9]+$')
        && onlyKeys(['starId'])
        && request.resource.data.starId is string
        && existsAfter(/databases/$(database)/documents/openedStars/$(uid)/items/$(request.resource.data.starId));
      allow update: if false;
      allow delete: if isSelf(uid);
    }
  }
}
